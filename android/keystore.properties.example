# COPY this file to android/keystore.properties on your Mac.
# NEVER commit android/keystore.properties or the keystore itself.
# Replace the placeholder values with the exact values used when creating the upload keystore.

storeFile=/ABSOLUTE/PATH/TO/talent-passport-upload-keystore.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=talent-passport-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
